# Church Manager environment template.
# Copy to .env for local notes, or set these as deployment secrets/env vars.

NODE_ENV=development
PORT=3000

# Core app identity
CHURCH_NAME="Dunwell Methodist"
PUBLIC_URL=http://localhost:3000
MEMBER_ID_PREFIX=DMS

# Required outside tests. Use a long random value:
#   openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL database and persistent file storage
# Use a dedicated non-production database when running the integration suite.
DATABASE_URL=postgresql://user:password@localhost:5432/church_manager
PHOTO_DIR=./photos

# Support and alert routing
SUPPORT_EMAIL=support@example.com
ALERT_EMAIL=alerts@example.com
ALERT_WEBHOOK_URL=

# SMS: one platform account at Arkesel or mNotify. SMS_PROVIDER picks which
# (ARKESEL, the default, or MNOTIFY); with that provider's key empty, SMS runs
# in dry-run mode. SMS_SENDER_ID is the sender name for churches without an
# approved name of their own (ARKESEL_SENDER is still read if it is unset).
# Each church's own name must be registered with the provider, then approved
# in /platform, before it is used.
SMS_PROVIDER=ARKESEL
ARKESEL_API_KEY=
MNOTIFY_API_KEY=
SMS_SENDER_ID=CHURCH

# Device notifications (Web Push) for allowance alerts. Generate a pair with
# `npx web-push generate-vapid-keys`. Leave empty to turn them off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (https: or mailto:); defaults to PUBLIC_URL.
VAPID_SUBJECT=

# SMTP email provider. Leave incomplete for dry-run mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Resend email provider API key.
RESEND_API_KEY=
REQUIRE_EMAIL_VERIFICATION=0

# PostgreSQL backup and restore drill
BACKUP_DIR=./backups/postgres
BACKUP_KEEP_DAYS=30
BACKUP_UPLOAD_URL=
RESTORE_DRILL_DATABASE_URL=
ALLOW_RESTORE_DRILL=0

# Birthday automation
BIRTHDAY_HOUR=7
BIRTHDAY_TEMPLATE="Happy birthday, {first_name}! May God bless your year ahead. - {church_name}"

# Country code for local phone numbers typed with a leading 0 (staff phone sign-in).
DEFAULT_PHONE_COUNTRY_CODE=233
